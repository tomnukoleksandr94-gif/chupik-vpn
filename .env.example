# Скопіюйте в .env і заповніть. НІКОЛИ не комітьте .env!
BOT_TOKEN=1234567890:ABC-DEF...
SECRET_KEY=довгий-випадковий-рядок            # openssl rand -hex 32
ADMIN_TOKEN=інший-випадковий-рядок            # пароль адмін-панелі
BASE_URL=https://твій-backend.duckdns.org   # публічна URL цього сервера (обов'язково HTTPS для карток)
WEB_SITE_URL=https://tomnukoleksandr94-gif.github.io/chupik-vpn
MINIAPP_URL=https://tomnukoleksandr94-gif.github.io/chupik-vpn/miniapp/
BRAND_PHOTO_URL=https://tomnukoleksandr94-gif.github.io/chupik-vpn/miniapp/chupik-brand.jpg
DB_PATH=chupik.db
WEB_SESSION_DAYS=30

# WireGuard-сервери (SSH)
WG_SSH_USER=root
WG_SSH_KEY=|  # вміст приватного SSH-ключа або шлях до файлу

# LiqPay (ПриватБанк) — оплата картою з виплатами на картку UA. Пусто = вимкнено.
# Ключі з кабінету liqpay.ua: налаштування → API. Гроші припадають на карту торговця.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# Stripe (альтернатива для карток, виплати на IBAN) — пусто = вимкнено
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
